# ============================================================
# 安知 AnZhi — Git 忽略规则
# ============================================================

# ------------------------------------------------------------
# 【最高优先级】敏感信息 —— 绝对禁止提交
# PROJECT_SPEC 第三十五节 / 第四十六节 / AI_RULES 第九节
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
credentials.json

# ------------------------------------------------------------
# Python / FastAPI
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# 注意：切勿写成裸的 lib/ 或 lib64/ ——
# 那会误伤 frontend/lib/（Flutter 源码目录），导致整个应用源码无法提交。
# 这里限定到 backend/ 下，只作用于 Python 虚拟环境产物。
backend/lib/
backend/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境
.venv/
venv/
ENV/
env/
.python-version

# 测试与覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# 数据库（SQLite 本地数据不入库）
*.db
*.sqlite
*.sqlite3
*.db-journal

# ------------------------------------------------------------
# Flutter / Dart
# ------------------------------------------------------------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
.flutter-plugins-dependencies

# Flutter 生成文件
**/generated_plugin_registrant.dart
*.g.dart
*.freezed.dart


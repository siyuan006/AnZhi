# ============================================================
# 安知 AnZhi — 后端环境变量模板
# ============================================================
# 使用方式：
#   1. 在本目录（backend/）复制本文件为 .env
#   2. 填入真实值
#   3. 永远不要提交 .env
#
# PowerShell:  Copy-Item .env.example .env
# Bash:        cp .env.example .env
#
# 说明：本模板只包含空值，任何真实密钥都不允许写进仓库。
# ============================================================

# ------------------------------------------------------------
# DeepSeek API（阶段 8 已接通代码，留空则 /api/chat 返回 503）
# 获取地址: https://platform.deepseek.com/api_keys
# 留空时后端仍可正常启动，健康检查会如实报告 ai_service=not_configured
#
# ⚠️ 这一行填好的 .env 绝对不能提交到 Git（PROJECT_SPEC 第三十五节）
# ------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 大模型生成一段回答通常要十几秒，超时给太短会大量误报失败。
# 但仍必须有上限：没有超时的话，上游卡住会让请求一直挂着。
DEEPSEEK_TIMEOUT=60

# ------------------------------------------------------------
# 应用配置
# ------------------------------------------------------------
APP_NAME=AnZhi
APP_ENV=development
DEBUG=true

# ------------------------------------------------------------
# 数据库（V1.0 使用 SQLite，第六阶段接入）
# 相对路径以 backend/ 为基准，即 backend/anzhi.db
# ------------------------------------------------------------
DATABASE_URL=sqlite:///./anzhi.db

# ------------------------------------------------------------
# 服务监听
# 注意：Android 模拟器访问宿主机需用 10.0.2.2:8000；真机需用电脑局域网 IP
# ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------
# CORS 允许来源（仅服务浏览器 / Flutter Web 调试）
# Flutter 原生端不受同源策略限制，不依赖此项。
# 开发环境留空则默认放开为 ["*"]；生产环境必须显式填写来源。
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

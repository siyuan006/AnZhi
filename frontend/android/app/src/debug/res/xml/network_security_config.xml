<?xml version="1.0" encoding="utf-8"?>
<!--
  安知 —— debug 专用网络安全配置（仅对 debug 构建生效，不会进入正式包）

  真机通过局域网 IP 调试时（flutter run --dart-define=ANZHI_API_BASE_URL=http://192.168.x.x:8000），
  地址不固定，无法像 main 那样逐个开白名单，因此 debug 构建整体放行明文流量。

  正式包使用 `src/main/res/xml/network_security_config.xml`，只放行本机回环地址。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>

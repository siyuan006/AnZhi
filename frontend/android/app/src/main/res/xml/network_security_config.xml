<?xml version="1.0" encoding="utf-8"?>
<!--
  安知 —— 网络安全配置

  Android 9（API 28）起默认禁止明文 HTTP 流量。开发期后端是
  `http://10.0.2.2:8000`（模拟器访问宿主机）这类明文地址，
  不做配置就会直接连接失败。

  这里不采用 `android:usesCleartextTraffic="true"` 全局放行，
  而是只对**本机回环类地址**开白名单：

    10.0.2.2  Android 模拟器映射到宿主机的固定地址
    127.0.0.1 / localhost  桌面端与真机端口转发

  这些地址永远不可能指向公网服务器，因此放行它们不会削弱正式包的安全性。
  真机连局域网 IP 调试的场景由 `src/debug/` 下的宽松配置覆盖，且仅对 debug 生效。
-->
<network-security-config>
    <!-- 其余一切域名：强制 HTTPS -->
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
